/* MODULE JuliaB; */

#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <graphics.h>

#define P 9
#define Delay 27

double X1[P], Y1[P], X2[P], Y2[P];
double AA[Delay], BA[Delay];
double X, Y, R, T, OA, OB, A, B, A1, B1, AS, BS, R1;
unsigned S, J, N, M, At;
char K;
/* Color : Graphics.PaletteType; */

void DrawPlot()
{
    A1 = (0.25-A) / 2.0;
    B1 = -B / 2.0;
    R1 = sqrt( A1*A1 + B1*B1 );

    X1[0] = 0.5+sqrt( R1+A1 );
    Y1[0] = sqrt( R1-A1 );
    if (B > 0.0)
	Y1[0] = -Y1[0];
    putpixel( (int)( (X1[ 0 ]+2.667)*119.81),
	(int)( (Y1[ 0 ]+2.000)*87.253), random( 15 ) );
    S = 1;
    for (J=S;J<=P;J++)
    {
	X = X1[ J-1 ];
	Y = Y1[ J-1 ];
	R = sqrt( (X-A)*(X-A)+(Y-B)*(Y-B) )/2.0;
	T = (X-A) / 2.0;
	X1[ J ] = sqrt( R+T );
	X2[ J ] = -X1[ J ];
	Y1[ J ] = sqrt( R-T );
	if ( Y<B )
	    Y1[ J ] = -Y1[ J ];
	Y2[ J ] = -Y1[ J ];
	putpixel( (int)( (X1[ J ]+2.667)*119.81),
	    (int)( (Y1[ J ]+2.000)*87.253), ((J+4) % 15)+1 );
	putpixel( (int)( (X2[ J ]+2.667)*119.81),
	    (int)( (Y2[ J ]+2.000)*87.253), ((J+4) % 15)+1 );
    }/* for */
    for (M=1;M<=(1<<(P-1));M++)
	/* M := 1 TO (* 2047 *) (1 << (P-1))-1 DO */
    {
	S = P;
	N = M;
	while (N % 2==0)
	{
	/* WHILE (N MOD 2) = 0 DO */
	    N = N/2;
	    S--;
	}/* while */
	X1[ S-1 ] = X2[ S-1 ];
	Y1[ S-1 ] = Y2[ S-1 ];
	for (J=S;J<=P;J++)
	{
	/* FOR J := S TO P DO */
	    X = X1[ J-1 ];
	    Y = Y1[ J-1 ];
	    R = sqrt( (X-A)*(X-A)+(Y-B)*(Y-B) )/2.0;
	    T = (X-A) / 2.0;
	    X1[ J ] = sqrt( R+T );
	    X2[ J ] = -X1[ J ];
	    Y1[ J ] = sqrt( R-T );
	    if (Y<B)
		Y1[ J ] = -Y1[ J ];
	    Y2[ J ] = -Y1[ J ];
	    putpixel( (int)( (X1[ J ]+2.667)*119.81),
		(int)( (Y1[ J ]+2.000)*87.253), ((S+4) % 15)+1 );
	    putpixel( (int)( (X2[ J ]+2.667)*119.81),
		(int)( (Y2[ J ]+2.000)*87.253), ((S+4) % 15)+1 );
	}/* for */
    }/* for */

}/* DrawPlot */


