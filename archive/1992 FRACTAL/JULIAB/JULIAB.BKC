void main(void);

void main(void)
{
    /* Graph.InitEGA; */

    /*
    Color[ 0 ] = 0;
    FOR At := 1 TO 15 DO
        Color[ At ] := BYTE( Lib.RANDOM( 64 ) );
    END (* FOR *);

    Graphics.SetPalette( Color );
    */

    do {
	randomize();
	initgraph(DETECT, DETECT, "C:\\TC");
	/* Graph.GraphMode; */
	/* Graphics.SetFunc( Graphics.clr, 0 ); */

	A = random(1.0)*3.0 - 1.5;
	B = random(1.0)*3.0 - 1.5;
	AS = random(1.0)*0.2 - 0.1;
	BS = random(1.0)*0.2 - 0.1;

	for (At = 0; At<=Delay; At++)
	{
	    /* Graphics.SetFunc( Graphics.clr, 0 ); */
	    DrawPlot();
	    /*
	    Color[ RANDOM( 15 )+1 ] = BYTE( Lib.RANDOM( 64 ) );
	    Graphics.SetPalette( Color ); */
	    AA[ At ] = A;
	    BA[ At ] = B;

	    A = A + AS;
	    AS = AS - random(1.0*A*0.06
		- random(1.0)*0.03*AS + 0.015
		+ random(1.0)*0.08 - 0.04;
	    B = B + BS;
	    BS = BS - random(1.0)*B*0.06
		- random(1.0)*0.03*BS + 0.015
		+ random(1.0)*0.08 - 0.04;

	}/* for */

	At = 0;
	do {

	    /* Graphics.SetFunc( Graphics.clr, 0 );
	    Graphics.SetPlane( {0,1,2,3} ); */
	    ErasePlot();
	    AA[ At ] = A;
	    BA[ At ] = B;

	    /* Graphics.SetFunc( Graphics.xor, 0 ); */
	    DrawPlot();
	    /* Color[ rand()*15/MAX_RAND+1 ] := BYTE( rand()*64/MAX_RAND );
	    Graphics.SetPalette( Color ); */
	    A = A + AS;
	    AS = AS - random(1.0*A*0.06
		- random(1.0)*0.03*AS + 0.015
		+ random(1.0)*0.08 - 0.04;
	    B = B + BS;
	    BS = BS - random(1.0)*B*0.06
		- random(1.0)*0.03*BS + 0.015
		+ random(1.0)*0.08 - 0.04;

	    At++;
	    if ( At > Delay ) At = 0;

	} while (1);
	/* K := IO.RdKey(); */

    } while (K != 27);

}/* main */

